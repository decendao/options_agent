# ============================================================
# Options Agent — Environment Configuration
# Copy to .env and fill in your values.
# ============================================================

# ── Core behavior ──────────────────────────────────────────────────
DRY_RUN=true                         # true = alerts only (dry-run); false = real webhooks
USE_MOCK_DATA=true                  # true = offline mock data; false = live Alpaca/Polygon APIs
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
POLL_INTERVAL_SECONDS=30            # Full cycle interval in seconds (includes all batches)

# ── Stock Pool / Watchlist ─────────────────────────────────────────
# Option A — Simple comma-separated list (legacy mode):
WATCH_TICKERS=SPY,QQQ

# Option B — YAML watchlist file (recommended for 10+ tickers):
# WATCHLIST_PATH=data/watchlist.yaml
#   This enables the batch config below automatically.

# ── Rate-limit Batching (Alpaca Free Tier: 15 req/s) ─────────────────
# Split tickers into batches to avoid hitting rate limits.
# Formula: batch_size × 2 req (1 spot + 1 options) / 15 req/s ≈ time per batch
#
#  5 tickers/batch  × 2 req = 10 req → ~0.67s → set BATCH_INTERVAL=1.25
# 20 tickers total → 4 batches × 1.25s ≈ 5s cycle (perfect for POLL_INTERVAL_SECONDS=5)
BATCH_SIZE=5                        # How many tickers per batch
BATCH_INTERVAL_SECONDS=1.25         # Pause between batches (seconds)

# ── Alpaca API Keys (used for both spot quotes and options chains) ──────
# Get keys: https://app.alpaca.markets → Paper Trading → Generate New Key
# These map to config.spot_data_provider.api_key / options_data_provider.api_key
ALPACA_API_KEY=your_key_id_here
ALPACA_API_SECRET=your_secret_here    # keep private — do NOT commit!

# ── Polygon.io (IV history — supplementary) ───────────────────────────
# Used for IV Rank computation (needs 252-day history)
# Get key: https://polygon.io → Sign Up → API Keys
POLYGON_API_KEY=your_polygon_key_here
POLYGON_BASE_URL=https://api.polygon.io/v2
POLYGON_RATE_LIMIT_PER_MINUTE=100

# ── Options parameters ────────────────────────────────────────────────
OPTION_EXPIRY_LOOKAHEAD_DAYS=45     # Fetch expirations up to N days ahead
OPTION_MONEYNESS_RANGE_PCT=0.15     # ±15% from spot price (strike range)
RISK_FREE_RATE=0.0525              # ~5.25% Fed Funds (annualized)

# ── IV history ────────────────────────────────────────────────────
IV_HISTORY_DAYS=252                # Rolling window in trading days (~1 year)

# ── Risk thresholds (nested via __ delimiter) ───────────────────────
RISK_THRESHOLDS__GAMMA_WALL_PROXIMITY_PCT=0.02
RISK_THRESHOLDS__IV_CRUSH_IV_RANK_THRESHOLD=0.70
RISK_THRESHOLDS__IV_CRUSH_HOURS_BEFORE_EVENT=48
RISK_THRESHOLDS__EV_MIN_SPREAD_PCT=0.05
RISK_THRESHOLDS__ZERO_GAMMA_BREACH_BUFFER_PCT=0.005
RISK_THRESHOLDS__MAX_PAIN_DEVIATION_ALERT_PCT=0.05
RISK_THRESHOLDS__MAX_CONSECUTIVE_ERRORS=5

# ── Alert webhooks ──────────────────────────────────────────────────
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=             # HMAC-SHA256 signing key (optional)
SLACK_WEBHOOK_URL=                # Slack Incoming Webhook URL (optional)

# ── Prediction markets (Polymarket / Kalshi — public APIs, no key needed) ─
PREDICTION_MARKET_POLL_INTERVAL=60
