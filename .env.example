# ============================================================
# Options Monitoring & Macro Arbitrage Agent — Environment Config
# Copy to .env, fill in values, then run python main.py
# ============================================================

# ── Core behavior ───────────────────────────────────────────────
DRY_RUN=true                         # true = dry-run (alerts only); false = send real webhooks
USE_MOCK_DATA=true                  # true = offline mock data; false = real APIs
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
POLL_INTERVAL_SECONDS=30            # seconds between data cycles

# ── Watch list ───────────────────────────────────────────────
WATCH_TICKERS=SPY,QQQ               # comma-separated, e.g. SPY,QQQ,AAPL,NVDA

# ── Alpaca Market Data ──────────────────────────────────────────
# Get keys: https://app.alpaca.markets → Paper Trading → Generate New Key
# Free Tier: 15 req/s, options/snapshots rate-limited
# Unlimited Tier recommended for production
ALPACA_API_KEY=your_alpaca_key_id_here      # Key ID (format: AKTB...)
ALPACA_API_SECRET=your_alpaca_secret_here   # Secret Key (keep private — do NOT commit!)

# ── Polygon.io ─────────────────────────────────────────────────
# Get key: https://polygon.io → Sign Up → API Keys
# Used for IV history (Alpaca needs 252-day history for IV Rank)
# Polygon Starter Plan:5 keys, free
POLYGON_API_KEY=your_polygon_key_here

# ── Options parameters ─────────────────────────────────────────
OPTION_EXPIRY_LOOKAHEAD_DAYS=45     # how many days ahead to fetch option expirations
OPTION_MONEYNESS_RANGE_PCT=0.15     # ±15% from spot price (strike range filter)

# ── Black-Scholes parameters ─────────────────────────────────────
RISK_FREE_RATE=0.0525               # ~5.25% Fed Funds annualized

# ── Risk thresholds (nested via __ delimiter) ──────────────────
RISK_THRESHOLDS__GAMMA_WALL_PROXIMITY_PCT=0.02
RISK_THRESHOLDS__IV_CRUSH_IV_RANK_THRESHOLD=0.70
RISK_THRESHOLDS__IV_CRUSH_HOURS_BEFORE_EVENT=48
RISK_THRESHOLDS__EV_MIN_SPREAD_PCT=0.05
RISK_THRESHOLDS__ZERO_GAMMA_BREACH_BUFFER_PCT=0.005
RISK_THRESHOLDS__MAX_PAIN_DEVIATION_ALERT_PCT=0.05
RISK_THRESHOLDS__MAX_CONSECUTIVE_ERRORS=5

# ── Alert webhooks ─────────────────────────────────────────────
# Generic JSON POST endpoint (N8N, custom server, etc.)
ALERT_WEBHOOK_URL=
# Optional HMAC-SHA256 signing key for webhook verification
ALERT_WEBHOOK_SECRET=

# ── Slack notifications ────────────────────────────────────────
# Create at: Slack App Directory → Incoming Webhooks → Add New
SLACK_WEBHOOK_URL=

# ── IV history (for IV Rank) ────────────────────────────────────
IV_HISTORY_DAYS=252                 # rolling window in trading days (~1 year)
