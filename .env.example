# ============================================================
# Options Monitoring & Macro Arbitrage Agent — Environment Template
# Copy to .env and fill in your values.
# ============================================================

# ── Core behavior ─────────────────────────────────────────
DRY_RUN=true                        # Set false to enable live webhooks
USE_MOCK_DATA=true                  # Set false to use real APIs
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
POLL_INTERVAL_SECONDS=30            # Seconds between data cycles

# ── Watch list ────────────────────────────────────────────
WATCH_TICKERS=SPY,QQQ               # Comma-separated, no spaces

# ── Market Data ───────────────────────────────────────────
# Alpaca (primary) — get keys at https://app.alpaca.markets
# API Key ID:
ALPACA_API_KEY=your_alpaca_key_here
# API Secret (keep this private — do NOT commit to GitHub):
ALPACA_API_SECRET=

# Polygon.io (supplementary / IV history) — get key at https://polygon.io
POLYGON_API_KEY=your_polygon_key_here

# ── Options config ────────────────────────────────────────
OPTION_EXPIRY_LOOKAHEAD_DAYS=45     # Fetch expirations up to N days out
OPTION_MONEYNESS_RANGE_PCT=0.15     # ±15% from spot

# ── Black-Scholes risk-free rate ─────────────────────────
RISK_FREE_RATE=0.0525               # ~5.25% Fed Funds (annualized)


# ── Risk thresholds ───────────────────────────────────────
# (nested via __ delimiter)
RISK_THRESHOLDS__GAMMA_WALL_PROXIMITY_PCT=0.02
RISK_THRESHOLDS__IV_CRUSH_IV_RANK_THRESHOLD=0.70
RISK_THRESHOLDS__IV_CRUSH_HOURS_BEFORE_EVENT=48
RISK_THRESHOLDS__EV_MIN_SPREAD_PCT=0.05
RISK_THRESHOLDS__ZERO_GAMMA_BREACH_BUFFER_PCT=0.005
RISK_THRESHOLDS__MAX_PAIN_DEVIATION_ALERT_PCT=0.05
RISK_THRESHOLDS__MAX_CONSECUTIVE_ERRORS=5

# ── Webhooks ──────────────────────────────────────────────
ALERT_WEBHOOK_URL=                  # Generic JSON POST endpoint
ALERT_WEBHOOK_SECRET=               # Optional HMAC signing secret
SLACK_WEBHOOK_URL=                  # Slack Incoming Webhook URL

# ── IV history ───────────────────────────────────────────
IV_HISTORY_DAYS=252                 # Rolling window for IV Rank
